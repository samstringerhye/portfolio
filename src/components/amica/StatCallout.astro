---
interface Props {
  number: string
  label: string
}

const { number, label } = Astro.props
---

<section class="stat-callout" aria-label={`${number} ${label}`}>
  <span class="stat-callout-number">{number}</span>
  <span class="stat-callout-label">{label}</span>
</section>

<style>
  .stat-callout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    padding-block: var(--space-7, 3rem);
    padding-inline: var(--space-6);
    border-top: var(--border-width-1) solid var(--color-text-primary);
    border-bottom: var(--border-width-1) solid var(--color-text-primary);
    margin-block: var(--space-6);
    background: var(--color-bg-primary);
  }

  .stat-callout-number {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .stat-callout-label {
    max-width: 32rem;
    font-size: var(--text-100);
    color: var(--color-text-secondary, currentColor);
  }
</style>
