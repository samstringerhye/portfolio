---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt?: string
}

const { src, alt = 'Project hero image' } = Astro.props
---

<div class="cs-hero-image">
  <Image src={src} alt={alt} layout="full-width" format="webp" loading="eager" decoding="async" fetchpriority="high" />
</div>
