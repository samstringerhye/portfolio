---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt?: string
}

const { src, alt = 'Project hero image' } = Astro.props
---

<div class="cs-hero-image">
  <Image src={src} alt={alt} widths={[800, 1260, 1800, 2500]} sizes="100vw" format="webp" quality={90} loading="eager" decoding="async" fetchpriority="high" />
</div>
