---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import type { HeadingTag, TypographyRole } from '../types/typography'

interface Props {
  headline?: string
  headingTag?: HeadingTag
  headingRole?: TypographyRole
  cardTitleTag?: HeadingTag
  cardTitleRole?: TypographyRole
}

const {
  headline = 'Selected Work',
  headingTag = 'h2', headingRole = 'display',
  cardTitleTag = 'h3', cardTitleRole = 'ui',
} = Astro.props as Props
const SectionTag = headingTag as any
const CardTitleTag = cardTitleTag as any
const allWork = await getCollection('work')
const featured = allWork
  .filter(w => w.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map(w => ({
    title: w.data.title,
    client: w.data.client,
    role: w.data.role,
    year: w.data.year,
    thumbnail: w.data.thumbnail,
    slug: w.id,
  }))
---

<section class="work-section" id="selected-work" aria-label="Selected work">
  <div class="work-container">
    <div class="work-header">
      <SectionTag class={`work-label typo-${headingRole}`} data-reveal>{headline}</SectionTag>
      <a href="/work" class="work-see-all" data-reveal="fade" aria-label="See all work">
        <span class="work-see-all-label">See all</span>
        <svg class="work-see-all-icon" width="28" height="28" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="80" y1="100" x2="140" y2="100"/>
          <polyline points="115,75 140,100 115,125"/>
        </svg>
      </a>
    </div>

    <div class="work-carousel-container">
      <div class="work-carousel" data-work-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Selected work carousel">
        <div class="work-track">
          {featured.map(card => (
            <a
              href={`/work/${card.slug}`}
              class="work-card"
              data-work-card
              data-card-slug={card.slug}
              data-card-title={card.title}
              data-card-client={card.client}
              data-card-year={card.year}
            >
              <div class="work-card-inner">
                <Image
                  src={card.thumbnail}
                  alt={card.title}
                  layout="full-width"
                  format="webp"
                  loading="lazy"
                />
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="work-caption-row">
        <div class="work-caption-left">
          <p class="work-caption-meta typo-ui-caps">
            <span data-caption-meta></span>
          </p>
          <CardTitleTag class={`work-caption-title typo-${cardTitleRole}`}>
            <a href="" class="work-caption-link" data-caption-link></a>
          </CardTitleTag>
        </div>
        <div class="work-caption-right">
          <button
            class="work-nav-button work-nav-prev"
            data-nav="prev"
            aria-label="Previous slide"
            title="Previous slide"
          >
            <svg class="work-nav-icon" width="28" height="28" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="80" y1="100" x2="140" y2="100"/>
              <polyline points="115,75 140,100 115,125"/>
            </svg>
          </button>
          <button
            class="work-nav-button work-nav-next"
            data-nav="next"
            aria-label="Next slide"
            title="Next slide"
          >
            <svg class="work-nav-icon" width="28" height="28" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="80" y1="100" x2="140" y2="100"/>
              <polyline points="115,75 140,100 115,125"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .work-section {
    padding: 0;
    max-height: calc(100vh - var(--nav-height));
    display: flex;
    flex-direction: column;
  }

  @media (--2x) {
    .work-section {
      max-height: none;
    }
  }

  .work-container {
    padding: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .work-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--content-inset-md);
    flex-shrink: 0;
  }

  .work-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-text-primary);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }

  .work-label {
    color: var(--color-text-primary);
    margin: 0;
  }

  .work-see-all {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color var(--duration-medium, 0.3s) ease;
  }

  .work-see-all::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-text-primary);
    transform: scaleY(var(--border-draw, 1));
    transform-origin: top;
  }

  .work-see-all-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .work-see-all-icon {
    width: 65%;
    height: 65%;
    transition: transform var(--duration-medium, 0.3s) cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (hover: hover) {
    .work-see-all:hover .work-see-all-icon {
      transform: scale(1.2) rotate(-5deg);
      transition: transform 490ms cubic-bezier(0.5, 0, 0, 1);
    }
  }

  .work-carousel-container {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .work-carousel {
    overflow: hidden;
    position: relative;
    min-height: 320px;
    flex: 1;
  }

  .work-carousel:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }

  .work-carousel:focus:not(:focus-visible) {
    outline: none;
  }

  .work-track {
    display: flex;
    height: 100%;
    will-change: transform;
    touch-action: pan-y pinch-zoom;
  }

  .work-card {
    flex: 0 0 100%;
    position: relative;
    display: block;
    height: 100%;
    text-decoration: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .work-card-inner {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .work-card img {
    display: block;
    width: 100%;
    height: calc(100% + 2px);
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .work-caption-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--content-inset-sm);
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .work-caption-row::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-text-primary);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }

  .work-caption-left {
    min-width: 0;
    flex: 1;
    padding-right: var(--space-4);
  }

  .work-caption-meta {
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1);
    font-size: 1rem;
  }

  .work-caption-title {
    display: block;
    color: var(--color-text-primary);
    margin: 0;
  }

  .work-caption-link {
    color: inherit;
    text-decoration: none;
  }

  .work-caption-right {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
  }

  .work-caption-right::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-text-primary);
    transform: scaleY(var(--border-draw, 1));
    transform-origin: top;
  }

  .work-nav-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color var(--duration-medium, 0.3s) ease;
    padding: 0;
  }

  .work-nav-prev::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-text-primary);
  }

  .work-nav-icon {
    width: 65%;
    height: 65%;
    transition: opacity var(--duration-medium, 0.3s) ease;
  }

  .work-nav-prev .work-nav-icon {
    transform: rotate(180deg);
  }

  .work-nav-button:disabled {
    cursor: not-allowed;
  }

  .work-nav-button:disabled .work-nav-icon {
    opacity: 0.3;
  }

  @media (hover: hover) {
    .work-nav-button:not(:disabled):hover {
      background-color: var(--color-text-primary);
      color: var(--color-bg, white);
    }
  }

  @media (--2x) {
    .work-container {
      padding-inline: var(--page-margin);
    }

    .work-header {
      padding: var(--content-inset-sm);
    }

    .work-header::after {
      background: var(--color-rule);
      left: calc(var(--page-margin) * -1);
      right: calc(var(--page-margin) * -1);
    }

    .work-see-all::before {
      background: var(--color-rule);
    }

    .work-carousel {
      margin-inline: calc(var(--page-margin) * -1);
    }

    .work-caption-row {
      padding-inline: var(--content-inset-sm);
    }

    .work-caption-row::after {
      background: var(--color-rule);
      left: calc(var(--page-margin) * -1);
      right: calc(var(--page-margin) * -1);
    }

    .work-caption-right::before,
    .work-nav-prev::after {
      background: var(--color-rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card img {
      transition: none;
    }
  }
</style>

<script>
  let gsap: any
  let ScrollTrigger: any
  let CMY_COLORS: string[]
  let tightenSingleLineHeadings: any
  let colorIndex = 0

  function initWorkHover() {
    if (!window.matchMedia('(hover: hover)').matches) return
    document.querySelectorAll<HTMLElement>('.work-nav-button, .work-see-all').forEach((el) => {
      if (el.dataset.workHoverBound === 'true') return
      el.dataset.workHoverBound = 'true'

      el.addEventListener('mouseenter', () => {
        el.style.backgroundColor = CMY_COLORS[colorIndex++ % CMY_COLORS.length]
      })
      el.addEventListener('mouseleave', () => {
        el.style.backgroundColor = ''
      })
    })
  }

  function initWorkCarousel() {
    const workObservers = new WeakMap<Element, ResizeObserver>()

    document.querySelectorAll<HTMLElement>('[data-work-carousel]').forEach(carousel => {
      if (carousel.dataset.carouselInit === 'true') return
      carousel.dataset.carouselInit = 'true'

      const track = carousel.querySelector<HTMLElement>('.work-track')
      if (!track) return

      const slides = Array.from(track.querySelectorAll<HTMLElement>('.work-card'))
      if (slides.length <= 1) return

      const container = carousel.closest('.work-carousel-container') as HTMLElement
      const captionMeta = container?.querySelector<HTMLElement>('[data-caption-meta]')
      const captionLink = container?.querySelector<HTMLElement>('[data-caption-link]') as HTMLAnchorElement
      const prevBtn = container?.querySelector<HTMLButtonElement>('.work-nav-prev')
      const nextBtn = container?.querySelector<HTMLButtonElement>('.work-nav-next')

      let currentIndex = 0
      let snapPoints: number[] = []

      function buildSnapPoints() {
        snapPoints = slides.map((_, i) => -i * carousel.offsetWidth)
      }
      buildSnapPoints()

      const captionTargets = [captionMeta, captionLink].filter(Boolean) as HTMLElement[]
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function updateCaption(index: number, direction: 1 | -1 = 1, animate = true) {
        const slide = slides[index]
        if (!slide) return

        const applyText = () => {
          const slug = slide.dataset.cardSlug || ''
          const title = slide.dataset.cardTitle || ''
          const client = slide.dataset.cardClient || ''
          const year = slide.dataset.cardYear || ''

          if (captionMeta) captionMeta.textContent = `${client} · ${year}`
          if (captionLink) {
            captionLink.href = `/work/${slug}`
            captionLink.textContent = title
          }
        }

        if (!animate || prefersReducedMotion || !captionTargets.length) {
          applyText()
          return
        }

        gsap.killTweensOf(captionTargets)
        gsap.to(captionTargets, {
          x: direction * -8,
          opacity: 0,
          duration: 0.15,
          ease: 'power2.in',
          onComplete: () => {
            applyText()
            gsap.fromTo(captionTargets, { x: direction * 8, opacity: 0 }, { x: 0, opacity: 1, duration: 0.25, ease: 'power2.out' })
          },
        })
      }

      function updateNavButtons(index: number) {
        if (prevBtn) prevBtn.disabled = index === 0
        if (nextBtn) nextBtn.disabled = index === slides.length - 1
      }

      updateCaption(0, 1, false)
      updateNavButtons(0)

      function animateTo(index: number) {
        const i = Math.max(0, Math.min(index, slides.length - 1))
        if (i === currentIndex) return
        const direction = i > currentIndex ? 1 : -1
        currentIndex = i
        updateCaption(i, direction)
        updateNavButtons(i)
        gsap.to(track, {
          x: snapPoints[i],
          duration: 0.5,
          ease: 'power3.out',
          overwrite: true,
        })
      }

      // Keyboard navigation
      carousel.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'ArrowRight') { animateTo(currentIndex + 1); e.preventDefault() }
        else if ((e as KeyboardEvent).key === 'ArrowLeft') { animateTo(currentIndex - 1); e.preventDefault() }
      })

      // Prev/Next button navigation
      container?.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest('[data-nav]') as HTMLElement
        if (!btn) return
        const direction = btn.dataset.nav
        if (direction === 'prev') animateTo(currentIndex - 1)
        else if (direction === 'next') animateTo(currentIndex + 1)
      })

      // Scroll-triggered slide-in entrance
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      let entranceDone = !prefersReduced ? false : true

      if (!prefersReduced) {
        const startX = carousel.offsetWidth * 0.4
        gsap.set(track, { x: startX, opacity: 0 })
        ScrollTrigger.create({
          trigger: carousel.closest('.work-section') || carousel,
          start: 'top 70%',
          once: true,
          onEnter() {
            gsap.to(track, {
              x: snapPoints[0],
              opacity: 1,
              duration: 0.8,
              ease: 'power4.out',
              onComplete() {
                entranceDone = true
              },
            })
          },
        })
      }

      // Recalculate on resize — disconnect previous observer to prevent leaks
      if (workObservers.has(carousel)) workObservers.get(carousel)?.disconnect()
      const ro = new ResizeObserver(() => {
        buildSnapPoints()
        if (entranceDone) {
          const safeIndex = Math.min(currentIndex, slides.length - 1)
          gsap.set(track, { x: snapPoints[safeIndex] })
        }
      })
      workObservers.set(carousel, ro)
      ro.observe(carousel)
    })
  }

  async function init() {
    const [gsapMod, stMod, tokensMod, tightenMod] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
      import('../data/tokens'),
      import('./tighten-headings'),
    ])
    gsap = gsapMod.default
    ScrollTrigger = stMod.ScrollTrigger
    gsap.registerPlugin(ScrollTrigger)
    CMY_COLORS = tokensMod.accentRgba(1)
    tightenSingleLineHeadings = tightenMod.tightenSingleLineHeadings

    tightenSingleLineHeadings('.work-label, .work-caption-title')
    initWorkHover()
    initWorkCarousel()
  }

  function deferInit() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => init(), { timeout: 1500 })
    } else {
      setTimeout(init, 100)
    }
  }

  deferInit()
  document.addEventListener('astro:page-load', deferInit)
</script>
