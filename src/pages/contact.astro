---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Contact — Sam Stringer-Hye" description="Get in touch with Sam Stringer-Hye.">
  <section class="contact-page" aria-label="Contact">
    <h1 class="typo-display-md contact-heading">Contact</h1>
    <div class="contact-row">
    <div class="contact-body">

      <form class="contact-form" id="contact-form" action="/contact" method="POST" novalidate>
        <div class="contact-field">
          <label for="contact-name" class="typo-ui-caps">Name</label>
          <input type="text" id="contact-name" name="name" required autocomplete="name" />
          <p class="contact-field-error" id="contact-name-error" aria-live="polite" hidden>Please enter your name</p>
        </div>
        <div class="contact-field">
          <label for="contact-email" class="typo-ui-caps">Email</label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" />
          <p class="contact-field-error" id="contact-email-error" aria-live="polite" hidden>Please enter a valid email</p>
        </div>
        <div class="contact-field">
          <label for="contact-message" class="typo-ui-caps">Message</label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>
          <p class="contact-field-error" id="contact-message-error" aria-live="polite" hidden>Please enter a message</p>
        </div>
        <label for="website" style="position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; overflow: hidden;">Leave this field empty
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; overflow: hidden;" />
        </label>
        <input type="hidden" id="form-loaded" name="form_loaded" />
        <button type="submit" class="contact-submit typo-ui">Send message</button>
        <p class="contact-status" id="contact-status" aria-live="polite"></p>
      </form>
    </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .contact-heading {
    grid-column: 1 / -1;
    color: var(--color-text-primary);
    margin: 0;
    padding-block: var(--space-6);
    padding-inline: var(--content-inset-md);
  }

  .contact-row {
    position: relative;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .contact-row::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }


  .contact-body {
    grid-column: 4 / 10;
    padding-block: var(--space-5);
  }

  .contact-intro {
    color: var(--color-text-primary);
    margin: 0 0 var(--space-6);
    max-width: var(--prose-measure);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--prose-measure);
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-field label {
    color: var(--color-text-primary);
  }

  .contact-field input,
  .contact-field textarea {
    padding: var(--space-2);
    background: transparent;
    border: var(--border-width-1) solid var(--color-rule);
    color: var(--color-text-primary);
    font-family: var(--font-primary);
    font-size: var(--text-100);
    line-height: var(--line-height-normal);
    transition: border-color var(--duration-short) ease;
  }

  .contact-field input:focus-visible,
  .contact-field textarea:focus-visible {
    outline: none;
    border-color: var(--color-text-primary);
    box-shadow: var(--focus-ring);
  }

  .contact-field input[aria-invalid='true'],
  .contact-field textarea[aria-invalid='true'] {
    border-left: 3px solid var(--color-accent-text-1, #C5202F);
  }

  .contact-field-error {
    color: #C5202F;
    font-size: var(--text-100);
    line-height: var(--line-height-normal);
    margin: 0;
  }

  .contact-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-submit {
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    min-height: 44px;
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
    border: none;
    cursor: pointer;
    transition: opacity var(--duration-short) ease;
  }

  .contact-submit:disabled {
    opacity: var(--opacity-50);
    cursor: not-allowed;
  }

  @media (hover: hover) {
    .contact-submit:hover:not(:disabled) {
      opacity: var(--opacity-80);
    }
  }

  .contact-status {
    font-size: var(--text-100);
    margin: 0;
    min-height: 1.5em;
  }

  .contact-status.is-success {
    color: var(--color-text-primary);
  }

  .contact-status.is-error {
    color: #C5202F;
  }

  @media (--2x) {
    .contact-heading {
      grid-column: 1 / -1;
      padding-inline: var(--page-margin);
    }

    .contact-body {
      grid-column: 1 / -1;
      padding-inline: var(--page-margin);
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    if (!form) return
    if (form.dataset.bound === 'true') return
    form.dataset.bound = 'true'

    const status = document.getElementById('contact-status')!
    const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement
    const fields = {
      name: form.querySelector('#contact-name') as HTMLInputElement,
      email: form.querySelector('#contact-email') as HTMLInputElement,
      message: form.querySelector('#contact-message') as HTMLTextAreaElement,
    }
    ;(form.querySelector('#form-loaded') as HTMLInputElement).value = String(Date.now())

    const setFieldError = (field: HTMLInputElement | HTMLTextAreaElement, message: string) => {
      const error = document.getElementById(`${field.id}-error`) as HTMLParagraphElement
      const isInvalid = Boolean(message)

      field.setAttribute('aria-invalid', String(isInvalid))
      if (isInvalid) {
        field.setAttribute('aria-describedby', error.id)
        error.textContent = message
        error.hidden = false
      } else {
        field.removeAttribute('aria-invalid')
        field.removeAttribute('aria-describedby')
        error.hidden = true
      }
    }

    const validateField = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const value = field.value.trim()
      const message = field.id === 'contact-email'
        ? (!value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) ? 'Please enter a valid email' : '')
        : (!value ? `Please enter your ${field.id === 'contact-name' ? 'name' : 'message'}` : '')

      setFieldError(field, message)
      return !message
    }

    Object.values(fields).forEach((field) => {
      field.addEventListener('input', () => {
        validateField(field)
        submit.disabled = false
        submit.textContent = 'Send message'
      })
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      status.textContent = ''
      status.className = 'contact-status'

      const valid = Object.values(fields).map((field) => ({ field, valid: validateField(field) }))
      const firstInvalid = valid.find(({ valid }) => !valid)?.field
      if (firstInvalid) {
        firstInvalid.focus()
        return
      }

      const data = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        message: fields.message.value.trim(),
        website: (form.querySelector('#website') as HTMLInputElement).value,
        form_loaded: (form.querySelector('#form-loaded') as HTMLInputElement).value,
      }

      submit.disabled = true
      submit.textContent = 'Sending...'

      let timeout: number | undefined
      try {
        const controller = new AbortController()
        timeout = window.setTimeout(() => controller.abort(), 15_000)
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          signal: controller.signal,
        })
        const result = await res.json()

        if (res.ok) {
          status.textContent = 'Message sent. I\'ll be in touch.'
          status.classList.add('is-success')
          form.reset()
          submit.textContent = '✓ Sent'
          await new Promise((resolve) => window.setTimeout(resolve, 2000))
        } else {
          status.textContent = result.error || 'Something went wrong.'
          status.classList.add('is-error')
        }
      } catch (error) {
        status.textContent = error instanceof DOMException && error.name === 'AbortError'
          ? 'Request timed out. Please try again.'
          : 'Failed to send. Please try again.'
        status.classList.add('is-error')
      } finally {
        if (timeout !== undefined) window.clearTimeout(timeout)
        if (!status.classList.contains('is-success')) {
          submit.disabled = false
          submit.textContent = 'Send message'
        }
      }
    })
  }

  initContactForm()
  document.addEventListener('astro:page-load', initContactForm)
</script>
