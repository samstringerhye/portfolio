---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro'
import { getSortedWork, buildCaseStudyProps } from './_caseStudy'

export const prerender = false

const { slug } = Astro.params
const sorted = await getSortedWork()
const entry = sorted.find(e => e.id === slug && e.data.passwordProtected)
if (!entry) return Astro.redirect('/404')

const { Content, prevSlug, prevTitle, nextSlug, nextTitle, noindex, ogImage, jsonLd } = await buildCaseStudyProps(entry, sorted)
---

<CaseStudyLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  ogImage={ogImage}
  jsonLd={jsonLd}
  prevSlug={prevSlug}
  prevTitle={prevTitle}
  nextSlug={nextSlug}
  nextTitle={nextTitle}
  noindex={noindex}
>
  <Content />
</CaseStudyLayout>
